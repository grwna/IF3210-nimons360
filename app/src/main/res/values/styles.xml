<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MediumRoundedCorners">
        <item name="cornerSize">16dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="LoginLogoShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="LoginInputFieldContainer" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/login_background</item>
        <item name="boxStrokeColor">@color/login_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="hintTextColor">@color/login_text_secondary</item>
        <item name="startIconTint">@color/login_text_secondary</item>
        <item name="suffixTextColor">@color/login_primary</item>
    </style>

    <style name="LoginInputFieldText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/login_text_primary</item>
        <item name="android:textColorHint">@color/login_text_secondary</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="LoginPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/login_primary</item>
        <item name="cornerRadius">28dp</item>
    </style>
</resources>